+ mark('navigation-check-start');
+ const atAdmin=()=>{try{const url=new URL(page.url());return url.origin===base&&url.pathname==='/admin';}catch{return false;}};
+ try{
+  await Promise.race([
+   expect.poll(()=>{if(readinessAborted)throw Error('Existing fatal event');return atAdmin();},{timeout:30000}).toBe(true),
+   failed,
+  ]);
